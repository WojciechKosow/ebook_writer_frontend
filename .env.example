# Base URL of the Spring Boot backend (no trailing slash).
#
# Local dev against a local backend:
#   NEXT_PUBLIC_API_URL=http://localhost:8080
# Against the deployed backend (or in Vercel project env vars):
NEXT_PUBLIC_API_URL=https://ebookwriter-production.up.railway.app

# Canonical public marketing origin, absolute URL, no trailing slash. Used for
# SEO metadata: canonical links, sitemap.xml, robots.txt and social/OG images.
# Set this to the real production domain in Vercel (e.g. https://scrivetta.com).
NEXT_PUBLIC_SITE_URL=https://scrivetta.com
